# Copy to .env (git-ignored). Values here are read by gcm.contextual when a connector is built;
# variables already set in the environment take precedence.

# Local Ollama. Several models may be listed, separated by commas.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# University API (OpenAI-compatible chat completions, Bearer token).
UNI_API_BASE_URL=
UNI_API_KEY=
UNI_API_MODEL=
# Optional: json_schema (default), json_object or none, depending on what the server accepts.
# UNI_API_STRUCTURED=json_schema

# Google Gemini (REST).
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: where cache, logs and exported structures live (default: <project>/data).
# GCM_DATA_DIR=
