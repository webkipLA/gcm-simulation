# Copy to .env (git-ignored). Values here are read by gcm.contextual when a connector is built;
# variables already set in the environment take precedence.

# Local Ollama. Several models may be listed, separated by commas.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b, qwen3:8b
# true/false; empty = Ollama decides (qwen3 then thinks, which is slow)
OLLAMA_THINK=

# University API (OpenAI-compatible chat completions, Bearer token).
UNI_API_BASE_URL=
UNI_API_KEY=
UNI_API_MODEL=
# Optional: json_schema (default), json_object or none, depending on what the server accepts.
# UNI_API_STRUCTURED=json_schema

# Google Gemini (REST).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3 and later: minimal, low, medium or high (empty = model default)
GEMINI_THINKING_LEVEL=
# Gemini 2.5 only: thinking tokens, 0 = off on 2.5 Flash
GEMINI_THINKING_BUDGET=
# requests per minute the runner may start; match the limit shown in AI Studio
GEMINI_RPM=12

# Optional: where cache, logs and exported structures live (default: <project>/data).
# GCM_DATA_DIR=
