      <choice type="string" value="incompetent hierarchy"></choice>
    </chooser>
    <chooser x="260" y="435" height="60" variable="access-structure" current="1" width="119" display="access-structure">
      <choice type="string" value="organized anarchy"></choice>
      <choice type="string" value="competent hierarchy"></choice>
      <choice type="string" value="incompetent hierarchy"></choice>
    </chooser>
    <slider x="5" step="100" y="57" max="100000" width="181" display="stop-at" height="50" min="0" direction="Horizontal" default="50000.0" variable="stop-at"></slider>
    <switch x="190" y="57" height="50" on="false" variable="show-details?" width="188" display="show-details?"></switch>
    <monitor x="199" precision="0" y="502" height="61" fontSize="11" width="181" display="Total Resolutions">num-resolutions</monitor>
    <monitor x="7" precision="0" y="501" height="61" fontSize="11" width="189" display="Total Oversights">num-oversights</monitor>
    <monitor x="7" precision="17" y="815" height="60" fontSize="11" width="190" display="Currently Postponed Problems">count opportunities with [charged?]</monitor>
    <monitor x="7" precision="17" y="627" height="60" fontSize="11" width="189" display="Oversights Low Levels">num-oversights-low</monitor>
    <monitor x="7" precision="17" y="564" height="60" fontSize="11" width="189" display="Oversights High Levels">num-oversights-high</monitor>
    <monitor x="200" precision="17" y="626" height="60" fontSize="11" width="179" display="Resolutions Low Levels">num-resolutions-low</monitor>
    <monitor x="199" precision="17" y="564" height="60" fontSize="11" width="179" display="Resolutions High Levels">num-resolutions-high</monitor>
    <monitor x="8" precision="17" y="689" height="60" fontSize="11" width="189" display="Currently Blocked Decisions">count patches with [pcolor = white]</monitor>
    <monitor x="200" precision="17" y="689" height="60" fontSize="11" width="180" display="Ave Duration Blocked">precision ave-duration-blocked 2</monitor>
    <monitor x="8" precision="0" y="751" height="60" fontSize="11" width="189" display="Total Postponements">num-postponements</monitor>
    <monitor x="200" precision="0" y="752" height="60" fontSize="11" width="180" display="Total Buck-Passings">num-buck-passings</monitor>
    <monitor x="200" precision="17" y="877" height="60" fontSize="11" width="180" display="Ave Duration Buck-Passed">precision ave-duration-passed 2</monitor>
    <monitor x="6" precision="17" y="877" height="60" fontSize="11" width="191" display="Currently Buck-Passed Problems">count participants with [charged?]</monitor>
    <monitor x="200" precision="17" y="814" height="60" fontSize="11" width="181" display="Ave Duration Postponed">precision ave-duration-postponed 2</monitor>
    <button x="114" y="11" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="89" display="Go Step">go</button>
    <button x="206" y="12" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="105" display="Go Until">go</button>
    <switch x="313" y="13" height="40" on="false" variable="print?" width="66" display="print?"></switch>
