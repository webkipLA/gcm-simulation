<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; THE GARBAGE CAN MODEL ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;; This is free software. It is distributed with GNU Public Licence GPLv3 ;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Variables declaration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
globals [
          ;; Kinds of decision-making and kinds of flights.
          num-oversights ;; cumulative number of decisions by oversight
          num-blocked-oversights ;; cumulative number of decisions by oversight following a blocked decision process
          num-resolutions ;; cumulative number of decisions by resolution
          num-blocked-resolutions ;; cumulative number of decisions by resolution following a blocked decision process
          num-postponements ;; cumulative number of flights by postponement
          num-buck-passings ;; cumulative number of flights by buck-passing

          ;; Blocked decisions, postponed problems, passed problems.
          num-blocked ;; cumulative number of blocked decision processes
          duration-blocked ;; cumulative duration of blocked decision processes
          ave-duration-blocked ;; average duration of blocked decision processes
          num-postponed ;; cumulative number of postponed problems
          duration-postponed ;; cumulative duration of pairs opportunity-problem
          ave-duration-postponed ;; average duration of pairs opportunity-problem
          num-passed ;; cumulative number of passed problems
          duration-passed ;; cumulative duration of pairs participant-problem
          ave-duration-passed ;; average duration of pairs participant-problem

          ;; Indicators of decision-making by oversight and resolution at different hierarchical levels.
          hierarchy-divide ;; splits opportunities into two unequal portions, top and bottom of the hierarchy.
          num-oversights-high ;; cumulative number of oversights making use of opportunities at high hierarchical levels
          num-oversights-low ;; cumulative number of oversights making use of opportunities at low hierarchical levels
          num-resolutions-high ;; cumulative number of resolutions making use of opportunities at high hierarchical levels
          num-resolutions-low ;; cumulative number of resolutions making use of opportunities at low hierarchical levels
        ]

patches-own [pcolor-white-since] ;; since when it hosts a blocked decision process
turtles-own [blocked?] ;; whether an agent is allowed to move

breed [solutions solution]
breed [opportunities opportunity]
breed [participants participant]
breed [problems problem]

participants-own [ ability ;; the ability of participants
                   last-movement ;; the last time this participant moved
                   charged? ;; eventually, this participant is charged...
                   with-problem ;; ...with this problem
                 ]
opportunities-own [ last-movement ;; the last time this opportunity moved
                    charged? ;; eventually, this opportunity is charged...
                    with-problem ;; ...with this problem
                  ]
solutions-own [ efficiency ;; the efficiency of solutions
              ]
problems-own [ difficulty ;; the difficulty of problems
               postponed? ;; eventually, this problem has been postponed...
               to-opportunity ;; ...to this opportunity
               passed? ;; eventually, this problem has been passed...
               to-participant ;; ...to this participant
               since ;; when the flight began
             ]



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; INDEX OF PROCEDURES ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;; to setup
;;;;;; - to assign-importance
;;;;;; - to show-labels
;;;;;; end
;;;;;;
;;;;;; to go
;;;;;;
;;;;;; - to decision-making
;;;;;;   - to postpone
;;;;;;   - to pass-the-buck
;;;;;;   - to-report free-spot
;;;;;;   end
;;;;;;
;;;;;; - to move
;;;;;;   - to-report opportunities-can-move
;;;;;;   - to-report participant-can-move
;;;;;;   - to-report solution-can-move
;;;;;;   - to-report problem-can-move
;;;;;;   end
;;;;;;
;;;;;; - to monitor
;;;;;;   - to write-oversights                      
;;;;;;   - to write-resolutions                
;;;;;;   - to write-postponements              
;;;;;;   - to write-buck-passings             
;;;;;;   - to actors-involved           
;;;;;;   - to write-survivors  
;;;;;;   end
;;;;;;
;;;;;; - to print-output                                    
;;;;;;
;;;;;; end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;; What is done when the "Setup" button is pressed ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
to setup
  clear-all
  reset-ticks

  ;; Initializes the number of kinds of decision-making and flights.
  set num-oversights 0
  set num-blocked-oversights 0
  set num-resolutions 0
  set num-blocked-resolutions 0
  set num-postponements 0
  set num-buck-passings 0

  ;; Initializes the number of blocked decisions, of postponed problems and of passed problems.
  ;; Initializes the duration of blocked decisions, of postponed problems and of passed problems.
  set num-blocked 0
  set duration-blocked 0
  set num-postponed 0
  set duration-postponed 0
  set num-passed 0
  set duration-passed 0

  ;; Initializes the counters of oversights and resolutions at high and low hierarchical levels.
  ifelse (decision-structure != "organized anarchy" or availability-structure != "organized anarchy" or access-structure != "organized anarchy") [
    set num-oversights-high 0
    set num-oversights-low 0
    set num-resolutions-high 0
    set num-resolutions-low 0
  ] [
    set num-oversights-high "N/A"
    set num-oversights-low "N/A"
    set num-resolutions-high "N/A"
    set num-resolutions-low "N/A"
  ]

  ;; Initializes the counter of how long a decision process stays blocked.
  ask patches
    [set pcolor-white-since 0]

  ;; Creates the agents that are initially present in the organization.
  ;; The sequence of creation is such that the variable "who" takes the following values:
  ;; - For opportunities: from 0 to (number-of-opportunities - 1). This measures their importance.
  ;; - For participants: from number-of-opportunities to (number-of-opportunities + number-of-participants - 1)
  ;; - For solutions: from (number-of-opportunities + number-of-participants) to (number-of-opportunities + number-of-participants + number-of-solutions - 1)
  ;; - For problems: from (number-of-opportunities + number-of-participants + number-of-solutions) to (number-of-opportunities + number-of-participants + number-of-solutions + number-of-problems - 1)
  ;; Opportunity with who=0 is the least important. Opportunity with who=(number-of-opportunities - 1) is the most important.
  set-default-shape opportunities "opportunity"
  create-opportunities number-of-opportunities  ;; creates the choice opportunities and initializes their variables
  [
    setxy random world-width random world-height
    set last-movement 0
    set blocked? false
    set charged? false
    set with-problem nobody
  ]
  set-default-shape participants "participant"
  create-participants number-of-participants  ;; creates the participants and initializes their variables
  [
    setxy random world-width random world-height
    set ability random-float (max-ability - min-ability) + min-ability
    set last-movement 0
    set blocked? false
    set charged? false
    set with-problem nobody
  ]
  set-default-shape solutions "solution"
  create-solutions number-of-solutions  ;; creates the solutions and initializes their variables
  [
    setxy random world-width random world-height
    set efficiency random-float (max-efficiency - min-efficiency) + min-efficiency
    set blocked? false
  ]
  set-default-shape problems "problem"
  create-problems number-of-problems  ;; creates the problems and initializes their variables
  [
    setxy random world-width random world-height
    set difficulty random-float (max-difficulty - min-difficulty) + min-difficulty
    set blocked? false
    set postponed? false
    set to-opportunity nobody
    set passed? false
    set to-participant nobody
    set since 0
  ]
  
  ;; If a hierarchy is there, separate high-importance from low-importance opportunities
  if (decision-structure != "organized anarchy" or availability-structure != "organized anarchy" or access-structure != "organized anarchy")
    [assign-importance]
    
  ;; Show labels aside participants, solutions and problems
  if (show-details?)
    [show-labels]
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;; Separates high-importance from low-importance opportunities ;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to assign-importance
  ;; Identifies the number of levels of a fictional hierarchy large enough to entail all opportunities
  let l 1  ;; hierarchical level (1 denotes the highest level)
  let m 1  ;; opportunities added at each new level
  let n 1  ;; total number of opportunities of this hierarchy (can be greater than number-of-opportunities)
  while [n < number-of-opportunities] [
    set n (n + span-of-control * m)
    set m (span-of-control * m)
    set l (l + 1)
  ]
  ;; Computes the number of opportunities in the superior half of this hierarchy
  let mid-hierarchy int (l / 2)
  set l 1
  set m 1
  set n 1
  while [l < mid-hierarchy] [
    set n (n + span-of-control * m)
    set m (span-of-control * m)
    set l (l + 1)
  ]
  ;; Sets n as the hierarchy divide. Opportunities with "who" lower than n are at the top of the hierarchy.
  set hierarchy-divide n
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;; Writes labels on the screen and information on decision-making on the command center ;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to show-labels
  ask participants [
    set label round ability
  ]
  ask problems [
    set label round difficulty
  ]
  ask solutions [
    set label precision efficiency 1
  ]
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is done when the "Go Step" button is pressed and what is repeated at each step when the "Go Until" button is pressed ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; - Tick forward;
;; - Agents make decisions;
;; - Agents move;
;; - Observe the model.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  
  ;; Stop conditions
  if ((stop-at > 0) and (ticks = stop-at)) [                                         
    if (print?)                                                       
      [print-output]                                           
    if (show-details?)
      [write-survivors]
    stop
  ]

  ;; Step forward
  tick

  ;; Resolution, Oversight, Flight
  decision-making

  ;; Isolated agents, pairs opportunity-problem, pairs participant-problem.
  move
  
  ;; Monitor status of currently blocked decisions, as well as postponed and buck-passed problems
  monitor
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; DECISION - MAKING ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to decision-making
  ;; Though decisions are made by participants, it is more convenient to let patches operate.
  ask patches [
    ;; Resets lime and sky-blue patches to black.
    ifelse (any? problems-here with [postponed? or passed?])
      [set pcolor brown] [
        if (pcolor != white)
          [set pcolor black]
      ]
    ;; If there is at least one participant, one choice opportunity and one solution, then a decision is made.
    if (any? participants-here and any? opportunities-here and any? solutions-here) [
      ;; Agents paired because of a flight enter the decision process on equal status with the others.
      ask participants-here [
        if (charged?) [
          set charged? false
          set with-problem nobody
        ]
      ]
      ask opportunities-here [
        if (charged?) [
          set charged? false
          set with-problem nobody
        ]
      ]
      ask problems-here [
        if (postponed?) [
          set postponed? false
          set to-opportunity nobody
        ]
        if (passed?) [
          set passed? false
          set to-participant nobody
        ]
      ]
      ;; If there are problems as well, either they are resolved if their ability is sufficient or all agents stay put until another opportunity or another participant passes by and takes a problem away.
      ifelse (any? problems-here) [ 
        
        ;; RESOLUTION
        ;; If the sum of the ability of all participants on a patch, multiplied by the efficiency of the most efficient solution on the
        ;; same patch, is greater or equal than the sum of the difficulty of all problems on the same patch, then decisions are made by resolution.
        ifelse ((sum [ability] of participants-here)*([efficiency] of max-one-of solutions-here [efficiency]) >= (sum [difficulty] of problems-here)) [
          set num-resolutions num-resolutions + 1
          ;; A decision by resolution is marked by a green square. The counters of the duration of blocked decisions and flying pairs are reset.
          if (pcolor = white)
            [set num-blocked-resolutions num-blocked-resolutions + 1]
          set pcolor lime
          set pcolor-white-since 0
          ask problems-here [set since 0]
          ;; Write information on the control center.
          if (show-details?)
            [write-resolutions]
          ;; The indicators of the percentages of resolutions on low and high hierarchical levels.
          ;; Lower-numbered opportunities are the most important.
          if (decision-structure != "organized anarchy" or availability-structure != "organized anarchy" or access-structure != "organized anarchy") [
            ask one-of opportunities-here [
              ifelse (who <= hierarchy-divide)              
              [set num-resolutions-high num-resolutions-high + 1]
              [set num-resolutions-low num-resolutions-low + 1]
            ]
          ]
          ;; If there are still agents on the patch, they must be free to move. This is not obvious, because they may stem from a flight.
          ask turtles-here [
            if (blocked?) [set blocked? false]
          ]
        ]
        
        ;; BLOCKED DECISION PROCESS
        ;; If the ability of the participants is not sufficient to make a decision, all participants, one opportunity,
        ;; the most efficient solution and all problems on the patch are blocked.
        ;; Participants and problems that jump on a blocked decision process are captured, but only one opportunity and one solution stay.
        ;; The solution and the opportunity that stay are those that were initially involved in the failed attempt at adecision by resolution.
        ;; Eventually, a flight might enable the remaining agents to make a decision either by resolution or by oversight.
        [
          ask participants-here [set blocked? true]
          if (not any? opportunities-here with [blocked? = true])
            [ask one-of opportunities-here [set blocked? true]]
          if (not any? solutions-here with [blocked? = true])
            [ask max-one-of solutions-here [efficiency] [set blocked? true]]
          ask problems-here [set blocked? true]
          ;; A blocked decision process is marked by a white square.
          if (pcolor != white) [
            set pcolor white
            set pcolor-white-since ticks
          ]
          
          ;; FLIGHTS
          ;; Either a flight by postponement or buck-passing is attempted.
          ;; If there are the conditions for flights by postponement but not for flights by buck-passing.
          if (postpone? and count opportunities-here > 1 and any? opportunities-here with [last-movement = (ticks - 1) and ticks > pcolor-white-since] and (buckpass? = false or not any? participants-here with [last-movement = (ticks - 1) and ticks > pcolor-white-since])) [
            postpone
          ]
          ;; If there are the conditions for flights by buck-passing but not for flights by postponement.
          if (buckpass? and count participants-here > 1 and any? participants-here with [last-movement = (ticks - 1) and ticks > pcolor-white-since] and (postpone? = false or not any? opportunities-here with [last-movement = (ticks - 1) and ticks > pcolor-white-since])) [
            pass-the-buck
          ]
          ;; If there are the conditions for both flights by postponement and buck-passing.
          if (postpone? and count opportunities-here > 1 and any? opportunities-here with [last-movement = (ticks - 1) and ticks > pcolor-white-since] and buckpass? and count participants-here > 1 and any? participants-here with [last-movement = (ticks - 1) and ticks > pcolor-white-since]) [
            ;; Select at random either a flight by postponement or buck-passing.
            let coin-side random 2
            ifelse (coin-side = 0) [
              postpone
            ][
              pass-the-buck
            ]
          ]
        ]
      ]
      
      ;; OVERSIGHT
      ;; On the contrary, if there are no problems to be solved, decisions are made by oversight. If there are several participants,
      ;; several solutions and several opportunities on the same patch, all participants and all solutions make a decision exploiting
      ;; only one opportunity and making use of only one solution.
      [
        set num-oversights num-oversights + 1
        ;; A decision by oversight is marked by a sky-blue square. The counter of the duration of blocked decisions is reset.
        if (pcolor = white)
          [set num-blocked-oversights num-blocked-oversights + 1]
        set pcolor sky
        set pcolor-white-since 0
        ;; Write information on the control center
        if (show-details?)
          [write-oversights]
        ;; The indicators of the percentages of oversights on low and high hierarchical levels.
        ;; Lower-numbered opportunities are the most important opportunities.
        let chosenOppOve one-of opportunities-here
        if (decision-structure != "organized anarchy" or availability-structure != "organized anarchy" or access-structure != "organized anarchy") [
          ifelse ([who] of chosenOppOve <= hierarchy-divide)
            [set num-oversights-high num-oversights-high + 1]
            [set num-oversights-low num-oversights-low + 1]
        ]
        ;; If there are still agents on the patch, they must be free to move. This is not obvious, because they may stem from a flight.
        ask turtles-here [
          if (blocked?) [set blocked? false]
        ]
      ]
    ]
  ]
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Flights by postponement ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to postpone
  ;; One problem and one opportunity are singled out.
  let which-problem max-one-of problems-here [difficulty]
  let which-opportunity max-one-of opportunities-here [last-movement]
  ;; The most difficult problem is attached to the latest-arriving opportunity.
  ask which-opportunity [
    set blocked? false
    set charged? true
    set with-problem which-problem
    move-to free-spot
  ]
  ;; The latest-arriving opportunity is attached to the most difficult problem.
  ask which-problem [
    set blocked? false
    set postponed? true
    set to-opportunity which-opportunity
    set since ticks
    move-to to-opportunity
  ]
  ;; The new flight is recorded.
  set num-postponements num-postponements + 1
  ;; Write information on the control center.
  if (show-details?)
    [write-postponements]
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Flights by buck-passing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to pass-the-buck
  ;; One problem and one participant are singled out.
  let which-problem max-one-of problems-here [difficulty]
  let which-participant max-one-of participants-here [last-movement]
  ;; The most difficult problem is attached to the latest-coming participant.
  ask which-participant [
    set blocked? false
    set charged? true
    set with-problem which-problem
    move-to free-spot
  ]
  ;; The latest-coming participant is attached to the most difficult problem.
  ask which-problem [
    set blocked? false
    set passed? true
    set to-participant which-participant
    set since ticks
    move-to to-participant
  ]
  ;; The new flight is recorded.
  set num-buck-passings num-buck-passings + 1
  ;; Write information on the control center.
  if (show-details?)
    [write-buck-passings]
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; A procedure employed by flights ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report free-spot
  let which-patch nobody
  while [which-patch = nobody] [
    ask one-of patches with [pcolor = black] [
      if (any? turtles-here = false) [
        set which-patch self      
      ]
    ]
  ]
  report which-patch
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; AGENTS MOVE ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to move
  ;; Agents are only allowed to turn by multiples of 90 degrees.
  ;; The movement of participants may be constrained by the decision structure.
  ;; The movement of solutions may be constrained by the availability structure.
  ;; The movement of problems may be constrained by the access structure.
  ;; The movement of opportunities may be constrained by the decision structure, the availability structure and the access structure.

  ;; Flying couples move first. Their movements take account of the positions of other agents.
  ask patches [
    ;; Paired problems and opportunities move together.
    ;; Opportunities must consider where they are allowed to move. Problems just follow opportunities.
    ask opportunities-here with [not blocked? and charged?] [
      set heading ((random 4) * 90)
      let initialheading heading
      let stop? false
      while [stop? = false] [
        if (pcolor = brown)
          [set pcolor black]
        move-to patch-ahead 1
        set last-movement ticks
        set pcolor brown
        set stop? true
        set heading ((heading + 90) mod 360)
        if (heading = initialheading)
          [set stop? true]
      ]
    ]
    ask problems-here with [not blocked? and postponed? and to-opportunity != nobody] [
      move-to to-opportunity
    ]
    ;; Paired problems and participants move together.
    ;; Participants must consider where they are allowed to move. Problems just follow participants.
    ask participants-here with [not blocked? and charged?] [
      set heading ((random 4) * 90)
      let initialheading heading
      let stop? false
      while [stop? = false] [
        if (participant-can-move) [
          if (pcolor = brown)
            [set pcolor black]
          move-to patch-ahead 1
          set last-movement ticks
          set pcolor brown
          set stop? true
        ]
        set heading ((heading + 90) mod 360)
        if (heading = initialheading)
          [set stop? true]
      ]
    ]
    ask problems-here with [not blocked? and passed? and to-participant != nobody] [
      move-to to-participant
    ]
  ]

  ;; When no hierarchy is there, all agents move in different, randomly chosen directions.
  ;; When a hierarchy is there, opportunities move still freely, and before other agents.
  ;; By contrast, participants must take account of the decision structure, solutions take account of the availability structure and problems
  ;; take account of the access structure in order to approach opportunities.
  ask opportunities with [not blocked? and not charged?] [
    set heading ((random 4) * 90)
    if (opportunity-can-move) [
      move-to patch-ahead 1
      set last-movement ticks
    ]
  ]
  ask participants with [not blocked? and not charged?] [
    set heading ((random 4) * 90)            
    if (participant-can-move) [
      move-to patch-ahead 1
      set last-movement ticks
    ]
  ]
  ask solutions with [not blocked?] [
    set heading ((random 4) * 90)
    if (solution-can-move) [
      move-to patch-ahead 1
    ]
  ]
  ask problems with [not blocked? and not postponed? and not passed?] [
    set heading ((random 4) * 90)
    if (problem-can-move) [
      move-to patch-ahead 1
    ]
  ]

end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Conditions for agents to move ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report opportunity-can-move
  let can? true
  
  ;; Opportunities can not move towards certain participants
  if (decision-structure = "competent hierarchy") [
    ifelse (who <= hierarchy-divide) [ ; if this opportunity is very important (Note: lower "who" values = greater importance)
      ; it cannot move towards unable participants
      if (any? (participants-on patch-ahead 1) with [ability < (max-ability - min-ability) / 2])
        [set can? false]
    ][ ; if this opportunity is not very important
      ; it cannot move towards able participants
      if (any? (participants-on patch-ahead 1) with [ability > (max-ability - min-ability) / 2])
        [set can? false]
    ]
  ]  
  if (decision-structure = "incompetent hierarchy") [
    ifelse (who <= hierarchy-divide) [ ; if this opportunity is very important (Note: lower "who" values = greater importance)
      ; it cannot move towards able participants
      if (any? (participants-on patch-ahead 1) with [ability > (max-ability - min-ability) / 2])
        [set can? false]
    ][ ; if this opportunity is not very important
      ; it cannot move towards unable participants
      if (any? (participants-on patch-ahead 1) with [ability < (max-ability - min-ability) / 2])
        [set can? false]
    ]
  ]

  ;; Opportunities can not move towards certain solutions
  if (availability-structure = "competent hierarchy") [
    ifelse (who <= hierarchy-divide) [ ; if this opportunity is very important (Note: lower "who" values = greater importance)
      ; it cannot move towards inefficient solutions
      if (any? (solutions-on patch-ahead 1) with [efficiency < (max-efficiency - min-efficiency) / 2])
        [set can? false]
    ][ ; if this opportunity is not very important
      ; it cannot move towards efficient solutions
      if (any? (solutions-on patch-ahead 1) with [efficiency > (max-efficiency - min-efficiency) / 2])
        [set can? false]
    ]
  ]  
  if (availability-structure = "incompetent hierarchy") [
    ifelse (who <= hierarchy-divide) [ ; if this opportunity is very important (Note: lower "who" values = greater importance)
      ; it cannot move towards efficient solutions
      if (any? (solutions-on patch-ahead 1) with [efficiency > (max-efficiency - min-efficiency) / 2])
        [set can? false]
    ][ ; if this opportunity is not very important
      ; it cannot move towards inefficient solutions
      if (any? (solutions-on patch-ahead 1) with [efficiency < (max-efficiency - min-efficiency) / 2])
        [set can? false]
    ]
  ]

  ;; Opportunities can not move towards certain problems
  if (access-structure = "competent hierarchy") [
    ifelse (who <= hierarchy-divide) [ ; if this opportunity is very important (Note: lower "who" values = greater importance)
      ; it cannot move towards simple problems
      if (any? (problems-on patch-ahead 1) with [difficulty < (max-difficulty - min-difficulty) / 2])
        [set can? false]
    ][ ; if this opportunity is not very important
      ; it cannot move towards difficult problems
      if (any? (problems-on patch-ahead 1) with [difficulty > (max-difficulty - min-difficulty) / 2])
        [set can? false]
    ]
  ]  
  if (access-structure = "incompetent hierarchy") [
    ifelse (who <= hierarchy-divide) [ ; if this opportunity is very important (Note: lower "who" values = greater importance)
      ; it cannot move towards difficult problems
      if (any? (problems-on patch-ahead 1) with [difficulty > (max-difficulty - min-difficulty) / 2])
        [set can? false]
    ][ ; if this opportunity is not very important
      ; it cannot move towards simple problems
      if (any? (problems-on patch-ahead 1) with [difficulty < (max-difficulty - min-difficulty) / 2])
        [set can? false]
    ]
  ]
  
  report can?
end
  
to-report participant-can-move
  let can? true
  
  if (decision-structure = "competent hierarchy") [
    ifelse (ability > (max-ability - min-ability) / 2) [ ; if this participant has high ability
      ; it cannot move towards unimportant opportunities
      if (any? (opportunities-on patch-ahead 1) with [who > hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]
    ][ ; if this participant has low ability
      ; it cannot move towards important opportunities
      if (any? (opportunities-on patch-ahead 1) with [who <= hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]      
    ]
  ]
  
  if (decision-structure = "incompetent hierarchy") [
    ifelse (ability > (max-ability - min-ability) / 2) [ ; if this participant has high ability
      ; it cannot move towards important opportunities
      if (any? (opportunities-on patch-ahead 1) with [who <= hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]
    ][ ; if this participant has low ability
      ; it cannot move towards unmportant opportunities
      if (any? (opportunities-on patch-ahead 1) with [who > hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]      
    ]
  ]
  
  report can?
end

to-report solution-can-move
  let can? true
  
  if (availability-structure = "competent hierarchy") [
    ifelse (efficiency > (max-efficiency - min-efficiency) / 2) [ ; if this solution is efficient
      ; it cannot move towards unimportant opportunities
      if (any? (opportunities-on patch-ahead 1) with [who > hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]
    ][ ; if this solution is inefficient
      ; it cannot move towards important opportunities
      if (any? (opportunities-on patch-ahead 1) with [who <= hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]      
    ]
  ]
  
  if (availability-structure = "incompetent hierarchy") [
    ifelse (efficiency > (max-efficiency - min-efficiency) / 2) [ ; if this solution is efficient
      ; it cannot move towards important opportunities
      if (any? (opportunities-on patch-ahead 1) with [who <= hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]
    ][ ; if this solution is inefficient
      ; it cannot move towards unimportant opportunities
      if (any? (opportunities-on patch-ahead 1) with [who > hierarchy-divide])  ; Note: lower "who" values = greater importance
        [set can? false]      
    ]
  ]
  
  report can?
end

to-report problem-can-move
  let can? true
  
  if (access-structure = "competent hierarchy") [
    ifelse (difficulty > (max-difficulty - min-difficulty) / 2) [ ; if this is a difficult problem
      ; it cannot move towards unimportant opportunities
      if (any? (opportunities-on patch-ahead 1) with [who > hierarchy-divide]) ; Note: lower "who" values = greater importance
        [set can? false]
    ][ ; if this is a simple problem
      ; it cannot move towards important opportunities
      if (any? (opportunities-on patch-ahead 1) with [who <= hierarchy-divide]) ; Note: lower "who" values = greater importance
        [set can? false]      
    ]
  ]
  
  if (access-structure = "incompetent hierarchy") [
    ifelse (difficulty > (max-difficulty - min-difficulty) / 2) [ ; if this is a difficult problem
      ; it cannot move towards important opportunities
      if (any? (opportunities-on patch-ahead 1) with [who <= hierarchy-divide]) ; Note: lower "who" values = greater importance
        [set can? false]
    ][ ; if this is a simple problem
      ; it cannot move towards unmportant opportunities
      if (any? (opportunities-on patch-ahead 1) with [who > hierarchy-divide]) ; Note: lower "who" values = greater importance
        [set can? false]      
    ]
  ]
  
  report can?
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;; Monitor status of currently blocked decisions, as well as postponed and buck-passed problems ;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to monitor
  
  if (any? patches with [pcolor = white]) [
    ;; Number of blocked decision processes.
    set num-blocked num-blocked + count patches with [pcolor = white]
    ;; Duration of blocked decision processes.
    let duration-blocked-now 0
    ask patches with [pcolor = white] [
      set duration-blocked-now duration-blocked-now + (ticks - pcolor-white-since)
    ]
    set duration-blocked-now duration-blocked-now / count patches with [pcolor = white]
    set duration-blocked duration-blocked + duration-blocked-now
    set ave-duration-blocked duration-blocked / num-blocked
  ]
  
  if (any? problems with [postponed?]) [
    ;; Number of postponed problems.
    set num-postponed num-postponed + count opportunities with [charged?]
    ;; Duration of postponed problems
    let duration-postponed-now 0
    ask problems with [postponed?] [
      set duration-postponed-now duration-postponed-now + (ticks - since)
    ]
    set duration-postponed-now duration-postponed-now / count problems with [postponed?]
    set duration-postponed duration-postponed + duration-postponed-now
    set ave-duration-postponed duration-postponed / num-postponed
  ]
  
  if (any? problems with [passed?]) [
    ;; Number of passed problems.
    set num-passed num-passed + count participants with [charged?]
    ;; Duration of passed problems.
    let duration-passed-now 0
    ask problems with [passed?] [
      set duration-passed-now duration-passed-now + (ticks - since)
    ]
    set duration-passed-now duration-passed-now / count problems with [passed?]
    set duration-passed duration-passed + duration-passed-now
    set ave-duration-passed duration-passed / num-passed
  ]
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Writes in the Command Center ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;; details about each decision by either oversight or resolution, ;;;;;;;;;;;;;;;;;;;;;; 
;;;;;;;;;;;;;;;;;;; as well as each flight by either postponement or buck-passing ;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to write-oversights
  type "N. OVERSIGHTS: "
  write num-oversights
  actors-involved
end

to write-resolutions
  type "N. RESOLUTIONS: "
  write num-resolutions
  actors-involved
end

to write-postponements
  type "N. FLIGHTS BY POSTPONEMENT: "
  write num-postponements
  actors-involved
end

to write-buck-passings
  type "N. FLIGHTS BY BUCK-PASSING: "
  write num-buck-passings
  actors-involved
end

to actors-involved
  ask participants-here [
    type "      Who:"                                                 
    write who
    type ". One of:"
    write number-of-participants
    type " participants. Ability:"
    write ability
    type ". Charged?"
    write charged?
    type ". With problem:"
    write with-problem
    type "."
  ]
  ask opportunities-here [
    type "      Who:"                                               
    write who
    type ". One of:"
    write number-of-opportunities
    type " opportunities."
    type " Charged?"
    write charged?
    type ". With problem:"
    write with-problem
    type "."
  ]
  ask solutions-here [
    type "      Who:"     
    write who
    type ". One of:"
    write number-of-solutions
    type " solutions. Efficiency:"
    write efficiency
    type "."
  ]
  ask problems-here [
    type "      Who:"  
    write who
    type ". One of:"
    write number-of-problems
    type " problems. Difficulty:"
    write difficulty
    type ". Postponed?"
    write postponed?
    type ". To opportunity:"
    write to-opportunity
    type ". Passed?"
    write passed?
    type ". To participant:"
    write to-participant
    type "."
  ]
  print " "
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;; At simulation end, writes in the Command Center ;;;;;;;;;;;
;;;;;;;;;;;;;; information about surviving agents ;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to write-survivors
  print ""
  type "SURVIVING OPPORTUNITIES"
  print ""
  ifelse (any? opportunities) [
    type "Identities:"
    ask opportunities [ write who ]
    print " "
  ]
  [ type "none" ]
  type "SURVIVING PARTICIPANTS"
  print ""
  ifelse (any? participants) [
    type "Identities:"
    ask participants [ write (who - number-of-opportunities) ]
    print " "
  ]
  [ type "none" ]
  type "SURVIVING SOLUTIONS"
  print ""
  ifelse (any? solutions) [
    type "Identities:"
    ask solutions [ write (who - number-of-opportunities - number-of-participants) ]
    print " "
  ]
  [ type "none" ]
  type "SURVIVING PROBLEMS"
  print ""
  ifelse (any? problems) [
    type "Identities:"
    ask problems [ write (who - number-of-opportunities - number-of-participants - number-of-solutions) ]
    print " "
  ]
  [ type "none" ]
  print ""
end
                                                                                                             
                                                                                                             
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;             
;;;;;;;;;;;;;;;;;;;;;;;;;;;;; PRINT INFORMATION AT SIMULATION END ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;             
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;             
                                                                                                             
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  
;;;;;;;;;;;;;;;;;;;;;;;;; Prints the following ins separate output file;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  
;; - The cumulative number of decisions by oversight;                                                        
;; - The cumulative number of decisions by resolution;                                                       
;; - The cumulative number of blocked decision processes followed by an oversight;                           
;; - The cumulative number of blocked decision processes followed by a resolution;                           
;; - The cumulative number of flights by postponement;                                                       
;; - The cumulative number of flights by buckpassing;                                                        
;; - The average duration of blocked decision processes;                                                     
;; - The average duration of postponements;                                                                  
;; - The average duration of buck-passings;                                                                  
;; - The cumulative number of oversights at high hierarchical level;                                         
;; - The cumulative number of oversights at low hierarchical level;                                          
;; - The cumulative number of resolutions at high hierarchical level;                                        
;; - The cumulative number of resolutions at low hierarchical level;                                         
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  
                                                                                                             
to print-output                                   
  file-open "oversights.txt"                      
  file-print num-oversights                       
  file-close                                      
  file-open "resolutions.txt"                     
  file-print num-resolutions                      
  file-close                                      
  file-open "blocked-followed-by-oversights.txt"  
  file-print num-blocked-oversights               
  file-close                                      
  file-open "blocked-followed-by-resolutions.txt" 
  file-print num-blocked-resolutions              
  file-close                                      
  file-open "postponements.txt"                   
  file-print num-postponements                    
  file-close                                      
  file-open "buck-passings.txt"                   
  file-print num-buck-passings                    
  file-close                                      
  file-open "ave-duration-blocked.txt"            
  file-print ave-duration-blocked                 
  file-close                                      
  file-open "ave-duration-postponements.txt"      
  file-print ave-duration-postponed               
  file-close                                      
  file-open "ave-duration-buck-passings.txt"      
  file-print ave-duration-passed                  
  file-close                                      
  if (num-oversights-high = "N/A")                
    [set num-oversights-high 0]                   
  file-open "oversights-high-level.txt"           
  file-print num-oversights-high                  
  file-close                                      
  if (num-oversights-low = "N/A")                 
    [set num-oversights-low 0]                    
  file-open "oversights-low-level.txt"            
  file-print num-oversights-low                   
  file-close                                      
  if (num-resolutions-high = "N/A")               
    [set num-resolutions-high 0]                  
  file-open "resolutions-high-level.txt"          
  file-print num-resolutions-high                 
  file-close                                      
  if (num-resolutions-low = "N/A")                
    [set num-resolutions-low 0]                   
  file-open "resolutions-low-level.txt"           
  file-print num-resolutions-low                  
  file-close                                      
end                                               ]]></code>
